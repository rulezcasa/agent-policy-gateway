# LLM served on the ZGX Nano (Qwen3.6-35B-A3B via ZRT/vLLM) — OpenAI-compatible endpoint
# Port and model name come from `zrt status` (API ENDPOINT / SERVED AS columns) —
# 8080 is ZRT's default, and the model name drops the "hf:" pull-source prefix.
LLM_BASE_URL=http://<zgx-nano-tailscale-ip>:8080/v1
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4

# MCP tool server (business tools) — wherever it's actually running
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
